# v0.5.2 multi-provider API trial

# Optional default provider for the server route
DEFAULT_AI_PROVIDER=openai

# OpenAI (fully wired in this build)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium

# Pollinations (public endpoint; no key required in this build)
POLLINATIONS_MODEL=flux

# Scaffolded providers for future wiring
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_KEY=
