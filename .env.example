# v0.5.4 multi-provider API trial with Stability AI generation

# Optional default provider for the server route
DEFAULT_AI_PROVIDER=stability

# Stability AI (wired in v0.5.4)
STABILITY_API_KEY=your_stability_api_key_here
STABILITY_MODE=control-structure
STABILITY_OUTPUT_FORMAT=png
STABILITY_CONTROL_STRENGTH=0.72
STABILITY_NEGATIVE_PROMPT=people, cars, text, watermark, logo, deformed fence, wrong building, distorted architecture, unrealistic shadows, extra products

# OpenAI (also wired, optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium

# Pollinations (public endpoint; no key required in this build)
POLLINATIONS_MODEL=flux

# Scaffolded providers for future wiring
REPLICATE_API_TOKEN=
HUGGINGFACE_API_KEY=
